/**
 * Desc   :  로그아웃 기능
 * name   : f_샘플_submitlogout
 */
function f_logout(){
    $.ajax({
        type       : "POST",
        url        : contextRoot+"/logout.do",  
        data       : "",
        success    : function(data){
            $(location).attr('href',contextRoot +'/index.do');
        },
        error : function(request, status, error) {
            // 실패 시 후처리
            // 글로벌 에러메시지는 자동으로 출력되니 여기서 정의 하지 않아도 됨
            $(location).attr('href',contextRoot +'/index.do');
            
        }
    });
}


function f_nri_faq(hostUrl){
