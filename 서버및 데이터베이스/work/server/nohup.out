<script>
$(document).ready(function() {

    /**
     * Desc   : Press Enter Key
     * name   : ready function
     * return : Next Step
    */
    $(".input_pw").keypress(function(evt_code) {
        
        if (evt_code.which == 13){
            var url = "www.iris.go.kr";
            if(url == "wwwbeta.iris.go.kr"){
                f_login_beta("SSO");
            }else{
                f_login("SSO");    
            }
            
            
        }
    });

    /**
     * Desc   : 아이디 입력창 자동 대문자 변경
     * name   : ready function
     * return : 아이디 입력창 자동 대문자 변경
     */
    $('.input_id').focusout(function(){
        $('.input_id').val($('.input_id').val().toUpperCase());
    });
});
</script>
<script src="/cmmn/validator.do"></script>
<script type="text/javascript"> 

     var bCancel = false; 

    function validateLoginForm(form) {                                                                   
        if (bCancel) 
      return true; 
        else 
       return validateRequired(form); 
   } 

    function required () { 
     this.aa = new Array("username", "아이디 은(는) 필수 입력값입니다.", new Function ("varName", " return this[varName];"));
     this.ab = new Array("password", "패스워드 은(는) 필수 입력값입니다.", new Function ("varName", " return this[varName];"));
    } 


</script>

