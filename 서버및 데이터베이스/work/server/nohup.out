<script>

function f_nri_portal(hostUrl){
    window.open(location.protocol+'//'+hostUrl,'_blank');
}

function f_chat_bot(){
    var lgin_id = "";
    var url = "";
    if(lgin_id == ""){
        url = "https://chatbot.iris.go.kr/kistep";
    }else{
        url = "https://chatbot.iris.go.kr/kistep?loginId="+lgin_id;
    }
    window.open(url, '_blank', 'toolbar=no,menubar=no,scrollbars=yes,resizable=yes,top=100,left=100,width=560,height=840');
}
</script>

