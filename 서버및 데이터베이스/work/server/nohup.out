		<script type="text/javascript" src="/javascript.wq?q=/bootloader"></script><script type="text/javascript" src="/websquare/javascriptPluginAll.wq?w2xType=5&amp;postfix=NS4wXzQuNDQ2OEIuMjAyMTA3MTkuMTc1MjE5Xw==MS44&amp;compression=true"></script>

		<script type="text/javascript">
			function addScript(src){
				var headObj = document.getElementsByTagName("head")[0];
				var script = document.createElement('script');
				script.type = 'text/javascript';
				script.src = src;
				headObj.appendChild(script);
			}
	
			if(/RCMS_Tablet/.test(navigator.userAgent)){
				// whybrid app일때
				if(typeof top.cordova != "object"){
					addScript("../cordova.js");
					window.onload = function(){
		           		document.addEventListener("deviceready",init,false);
		           		if(typeof $h != "undefined"){
		           			$h.inappupdate.dismissScreen();
		           		}
		           	};
				} else {
					window.onload = init;
				}
			} else {
// 				document.domain = "rcms.go.kr"; // /ui/exo/kedms/RcmsServiceServlet.xml
				//pc
				window.onload = init;
			}
			
			function init() {
				try {
					gcm.CONTEXT_PATH = "";
					
					WebSquare.startApplication(WebSquareExternal.w2xPath);
				} catch(e) {
					alert(e.message);
				}
			}
		</script>
