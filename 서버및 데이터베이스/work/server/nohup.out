$(document).ready(function() {
    $('.tabs .depth4 li').each(function() {
        if ($(this).hasClass('active')) {
            $(this).find('a').attr('title', '선택된 탭메뉴');
        } else {
            $(this).find('a').attr('title', '비활성 탭메뉴');
        }
    });
});


// 마우스 우클릭 안되게 설정
document.addEventListener('contextmenu',function(){
    event.preventDefault();
});
    
/**
 * Desc   : NRI 사이트 링크
 * name   : f_nri()
 * param  : 폼 데이터
 * return : 결과 값
 */
 function f_nri(hostUrl, ssoConnectChk, gbn){
        
        if (hostUrl.indexOf("iris.go.kr") == -1){
            ssoConnectChk = "SESSION";
        }
        
        if (ssoConnectChk == "SSO") {
            $.ajax({
                type       : "POST",
                url        : contextRoot+"/lgin/lginadmn/ssoChk.do",
                data       : "",
                success    : function(data){
                    if (data.gdsSSOChk == "Y") {
                        if (gbn == "nri") {
                            window.open(location.protocol+'//'+hostUrl+'/sso/RequestConnect.jsp?RelayCd=' + data.gdsSSOSendCd + '&RelayState=/resources/nui/indexSSO.do', '_blank');
                        } else if (gbn == "portalWK") {
                            window.open(location.protocol+'//'+hostUrl+'/sso/RequestConnect.jsp?RelayCd=' + data.gdsSSOSendCd + '&RelayState=/indexSSO.do?targetUrl=portalWK', '_blank');
                        } else if (gbn == "note") {
                            window.open(location.protocol+'//'+hostUrl+'/sso/RequestConnect.jsp?RelayCd=' + data.gdsSSOSendCd + '&RelayState=/note/indexSSO.do', '_blank');
                        } else if (gbn == "sims") {
                            window.open(location.protocol+'//'+hostUrl+'/sso/RequestConnect.jsp?RelayState=/sims/ssoLogin.do', '_blank');
                        }
                    } else if (data.gdsSSOChk == "NOT_TOKEN") {
                        alert("로그인 시간이 만료되었습니다.");
                        $(location).attr('href', '/logout.do');
                    } else if (data.gdsSSOChk == "FOREIGNER") {
                        alert("아직 회원가입 승인처리가 완료되지 않았습니다.");
                    } else {
                        alert("로그인 후 사용이 가능한 페이지 입니다.");
                        $(location).attr('href', '/mbrs/entr/loginForm.do');
                    }
                },
                error : function(request, status, error) {
                    alert("로그인 시간이 만료되었습니다.");
                    $(location).attr('href', '/logout.do');
                }
            });
        } else if (ssoConnectChk == "SESSION") {
            if (gbn == "note") {
                $(location).attr('href',location.protocol+'//'+hostUrl+'/main.do');
            } else {
                $(location).attr('href',location.protocol+'//'+hostUrl+'/resources/nui/index.do');
            }
        }
}
 
/**
 * Desc   : 로그인 폼
 * name   : f_login_form
 * param  : 폼 데이터
 * return : 결과 값
 */
function f_login_form() {
        $('#memberForm').attr("action", contextRoot + "/mbrs/entr/loginForm.do");
        $('#memberForm').attr("method","post");
        $('#memberForm').submit();
}

